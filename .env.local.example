NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para el cron del resumen semanal (src/app/api/cron/resumen-semanal) —
# se salta Row Level Security a propósito, nunca la uses en otro lado.
# La sacas del panel de Supabase: Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier valor secreto tuyo. Vercel lo manda solo como
# "Authorization: Bearer <este valor>" cuando dispara el cron — así la ruta
# sabe que la llamada es legítima y no de cualquiera que adivine la URL.
CRON_SECRET=

# Para que los correos (bienvenida, resumen semanal, etc.) tengan el
# remitente y los enlaces correctos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_APP_URL=
